{
  "manifest_version": 3,
  "name": "Dueable",
  "description": "Canvas focus coach for Dueable.",
  "version": "0.1.0",
  "action": {
    "default_title": "Dueable"
  },
  "icons": {
    "16": "public/assets/logo.png",
    "32": "public/assets/logo.png",
    "48": "public/assets/logo.png",
    "128": "public/assets/logo.png"
  },
  "permissions": ["activeTab", "storage", "tabs", "scripting", "sidePanel"],
  "side_panel": {
    "default_path": "dist/index.html"
  },
  "host_permissions": ["http://localhost:3000/*", "https://localhost:3000/*", "https://dueable-web.vercel.app/*"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  }
}